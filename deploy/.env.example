# 배포 이미지 버전
IMAGE_TAG=replace-with-git-commit-sha

# MySQL
MYSQL_DATABASE=quietpath
MYSQL_USER=quietpath
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Redis
REDIS_PASSWORD=replace-with-strong-password

# 인증
APP_JWT_SECRET=replace-with-at-least-32-byte-random-secret
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://qpathlog.com,https://www.qpathlog.com
APP_AUTH_REFRESH_COOKIE_SECURE=true

# Kakao
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=https://qpathlog.com

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# S3
APP_RECORD_IMAGE_S3_BUCKET=quietpath-prod-record-images-381492289409-ap-northeast-2-an
APP_RECORD_IMAGE_S3_BASE_URL=https://quietpath-prod-record-images-381492289409-ap-northeast-2-an.s3.ap-northeast-2.amazonaws.com

# Web Push
APP_WEB_PUSH_PUBLIC_KEY=
APP_WEB_PUSH_PRIVATE_KEY=
APP_WEB_PUSH_SUBJECT=
